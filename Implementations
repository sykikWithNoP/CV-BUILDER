          />
        </Grid>

        {/* Avatar upload */}
        <Grid item xs={12}>
          <Box sx={{ display: 'flex', alignItems: 'center', gap: 2 }}>
            <Avatar src={data.avatar} sx={{ width: 64, height: 64 }}>
