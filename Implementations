/* ------------ Skills – split into three groups ------------ */
export const SkillGroups = ({ data, setData }: any) => {
  const groups = [
    { key: 'technical', label: 'Technical Skills' },
    { key: 'soft', label: 'Soft Skills' },
    { key: 'cloud', label: 'Cloud & Security' },
  ];

  const addSkill = (groupKey: string) => {
    const newArr = [...(data.skills?.[groupKey] || []), ''];
    setData({ ...data, skills: { ...data.skills, [groupKey]: newArr } });
  };

  const updateSkill = (groupKey: string, idx: number, val: string) => {
    const newArr = [...(data.skills?.[groupKey] || [])];
    newArr[idx] = val;
    setData({ ...data, skills: { ...data.skills, [groupKey]: newArr } });
  };

  const removeSkill = (groupKey: string, idx: number) => {
    const newArr = (data.skills?.[groupKey] || []).filter((_ : any, i: number) => i !== idx);
    setData({ ...data, skills: { ...data.skills, [groupKey]: newArr } });
  };

  return (
    <>
      {groups.map(g => (
        <Box key={g.key} mb={2}>
          <Box display="flex" alignItems="center" mb={1}>
            <strong>{g.label}</strong>
            <Button size="small" startIcon={<Add />} onClick={() => addSkill(g.key)} sx={{ ml: 2 }}>
              Add
            </Button>
          </Box>

          {(data.skills?.[g.key] || []).map((skill: string, i: number) => (
            <Box key={i} display="flex" alignItems="center" mb={1}>
              <TextField
                placeholder="e.g. Python"
                value={skill}
                fullWidth
                onChange={e => updateSkill(g.key, i, e.target.value)}
              />
              <IconButton size="small" color="error" onClick={() => removeSkill(g.key, i)}>
                <Delete />
              </IconButton>
            </Box>
          ))}
        </Box>
      ))}
    </>
  );
};
