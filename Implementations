5.6 Dashboard – The Real Builder (src/pages/Dashboard.jsx)
import { useEffect, useState } from 'react';
import {
  Container,
  Box,
  Paper,
  Typography,
  Button,
  Grid,
  Divider,
} from '@mui/material';
import TemplatePicker from '../components/TemplatePicker';
import CvBuilder from '../components/CvBuilder';
import axios from 'axios';
import DownloadIcon from '@mui/icons-material/Download';
import { useAuth } from '../contexts/AuthContext';
import Layout from '../components/Layout';

export default function Dashboard() {
  const { user } = useAuth();
  const [templates, setTemplates] = useState([]);
  const [selectedTemplate, setSelectedTemplate] = useState(null);
  const [formData, setFormData] = useState({});
  const [savedCvId, setSavedCvId] = useState(null);

  // Load templates once
  useEffect(() => {
    axios.get('/api/cv/templates', { withCredentials: true }).then(r => {
      setTemplates(r.data);
      setSelectedTemplate(r.data[0] ?? null);
    });
  }, []);

  const saveCv = async () => {
    if (!selectedTemplate) return;
    await axios.post(
      '/api/cv/save',
      { templateId: selectedTemplate.id, data: formData },
      { withCredentials: true }
    );
    // grab the row id just saved (simple approach: ask back the saved row)
    const { data } = await axios.get('/api/cv/my', { withCredentials: true });
    setSavedCvId(data.id);
    alert('CV saved!');
  };

  const downloadPdf = async () => {
    if (!savedCvId) return alert('You need to save first');
    const res = await axios.get(`/api/cv/download/${savedCvId}`, {
      responseType: 'blob',
      withCredentials: true,
    });
    const url = window.URL.createObjectURL(new Blob([res.data], { type: 'application/pdf' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = `CV_${savedCvId}.pdf`;
    a.click();
  };

  return (
    <Layout>
      <Container maxWidth="lg" sx={{ py: 4 }}>
        <Grid container spacing={3}>
          {/* Left – Template picker */}
          <Grid item xs={12} md={3}>
            <Paper sx={{ p: 2 }}>
              <Typography variant="h6" gutterBottom>
                Choose a Template
              </Typography>
              <TemplatePicker
                templates={templates}
                selected={selectedTemplate?.id}
                onSelect={setSelectedTemplate}
              />
            </Paper>
          </Grid>

          {/* Right – Builder */}
          <Grid item xs={12} md={9}>
            <Paper sx={{ p: 3 }}>
              <Typography variant="h5" gutterBottom>
                Edit Your CV – {selectedTemplate?.name}
              </Typography>

              <CvBuilder
                template={selectedTemplate}
                data={formData}
                setData={setFormData}
              />

              <Divider sx={{ my: 2 }} />
              <Box sx={{ display: 'flex', gap: 2 }}>
                <Button variant="contained" onClick={saveCv}>
                  Save
                </Button>
                {user?.verified && (
                  <Button
                    variant="outlined"
                    startIcon={<DownloadIcon />}
                    onClick={downloadPdf}
                    disabled={!savedCvId}
                  >
                    Download PDF
                  </Button>
                )}
              </Box>
            </Paper>
          </Grid>
        </Grid>
      </Container>
    </Layout>
  );
}
CvBuilder (see the full component later in this doc) reproduces the original form side from your demo, but lives in React state and writes directly into formData. It contains helpers for:

Adding/removing Experience, Education, Skills, Languages, Certificates,
A photo upload component that POSTs to /api/cv/upload-avatar (not shown – use Multer, same security as above),
Dynamic colour picker (the same 8 presets you already have + a custom colour input).
All changes instantly reflect in a preview pane; the preview is just the server‑side Mustache‑rendered HTML inside a <iframe> so the live preview mirrors the final PDF exactly.

