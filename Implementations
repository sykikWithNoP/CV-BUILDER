app.listen(PORT, () => console.log(`🚀 Server listening on ${PORT}`));
4.2 Auth Routes – routes/auth.js
const express = require('express');
const router = express.Router();
const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const { body, validationResult } = require('express-validator');
const crypto = require('crypto');
const nodemailer = require('nodemailer');
const rateLimit = require('express-rate-limit');

/* ---------- RATE LIMITERS ---------- */
const loginLimiter = rateLimit({
  windowMs: 10 * 60 * 1000,
  max: 5,
  handler: (_, res) => res.status(429).json({ error: 'Too many login attempts. Try later.' }),
});

const signupLimiter = rateLimit({
  windowMs: 10 * 60 * 1000,
  max: 5,
});

/* ---------- HELPERS ---------- */
async function sendVerificationEmail(email, token) {
  const transporter = nodemailer.createTransport({
    host: process.env.SMTP_HOST,
    port: Number(process.env.SMTP_PORT),
    secure: false,
    auth: {
      user: process.env.SMTP_USER,
      pass: process.env.SMTP_PASS,
    },
  });

  const verifyLink = `${process.env.BASE_URL}/api/auth/verify?token=${token}`;
  await transporter.sendMail({
    from: `"CV Builder" <${process.env.SMTP_USER}>`,
    to: email,
    subject: 'Verify your CV Builder account',
    html: `
      <p>Hello,</p>
      <p>Click <a href="${verifyLink}">here</a> to verify your account. This link expires in 24 h.</p>
      <p>If you didn’t sign up, you can ignore this email.</p>
    `,
  });
}

/* ---------- SIGN‑UP ---------- */
router.post(
  '/signup',
  signupLimiter,
  [
    body('firstName').trim().isLength({ min: 2 }).escape(),
    body('lastName').trim().isLength({ min: 2 }).escape(),
    body('email').isEmail().normalizeEmail(),
    body('password')
      .isLength({ min: 8 })
      .matches(/[A-Z]/)
      .matches(/[0-9]/)
      .withMessage('Password must contain an uppercase letter and a number.'),
  ],
  async (req, res) => {
    const errors = validationResult(req);
    if (!errors.isEmpty()) return res.status(400).json({ errors: errors.array() });

    const { firstName, lastName, email, password } = req.body;
    const pool = req.app.locals.pool;
    const client = await pool.connect();

    try {
      const exists = await client.query('SELECT id FROM users WHERE email=$1', [email]);
      if (exists.rowCount) return res.status(400).json({ error: 'Email already taken.' });

      const hash = await bcrypt.hash(password, 12);
      const insert = await client.query(
        `INSERT INTO users (first_name,last_name,email,password_hash,verified,created_at)
         VALUES ($1,$2,$3,$4,$5,NOW()) RETURNING id`,
        [firstName, lastName, email, hash, false]
      );
      const userId = insert.rows[0].id;

      // Email verification token
      const token = crypto.randomBytes(32).toString('hex');
      await client.query(
        `INSERT INTO email_verifications (user_id, token, expires_at)
         VALUES ($1,$2,NOW() + INTERVAL '1 day')`,
        [userId, token]
      );
      await sendVerificationEmail(email, token);

      // Log sign‑up
      await client.query(
        `INSERT INTO signup_logs (user_id, ip_address, user_agent, success)
         VALUES ($1,$2,$3,$4)`,
        [userId, req.ip, req.get('User-Agent'), true]
      );

      res.status(201).json({ message: 'Signup successful – check your email to verify.' });
    } catch (e) {
      console.error(e);
      await client.query(
        `INSERT INTO signup_logs (user_id, ip_address, user_agent, success)
         VALUES (NULL,$1,$2,$3)`,
        [req.ip, req.get('User-Agent'), false]
      );
      res.status(500).json({ error: 'Server error' });
    } finally {
      client.release();
    }
  }
);

/* ---------- EMAIL VERIFICATION ---------- */
router.get('/verify', async (req, res) => {
  const token = req.query.token;
  if (!token) return res.status(400).send('Invalid token');

  const pool = req.app.locals.pool;
  const client = await pool.connect();

  try {
    const v = await client.query(
      `SELECT user_id FROM email_verifications WHERE token=$1 AND expires_at > NOW()`,
      [token]
    );
    if (!v.rowCount) return res.status(400).send('Token expired or invalid');

    const userId = v.rows[0].user_id;
    await client.query('UPDATE users SET verified=true WHERE id=$1', [userId]);
    await client.query('DELETE FROM email_verifications WHERE user_id=$1', [userId]);

    // Issue short‑lived access JWT (HttpOnly)
    const accessToken = jwt.sign(
      { userId, verified: true },
      process.env.JWT_SECRET,
      { expiresIn: process.env.JWT_EXPIRES_IN }
    );
    const refreshToken = jwt.sign(
      { userId },
      process.env.REFRESH_TOKEN_SECRET,
      { expiresIn: process.env.REFRESH_EXPIRES_IN }
    );
    await client.query(
      `INSERT INTO refresh_tokens (user_id, token, expires_at)
       VALUES ($1,$2,NOW() + INTERVAL '7 days')
       ON CONFLICT (user_id) DO UPDATE SET token=$2, expires_at=NOW() + INTERVAL '7 days'`,
      [userId, refreshToken]
    );

    res
      .cookie('access_token', accessToken, {
        httpOnly: true,
        secure: true,
        sameSite: 'strict',
        maxAge: 15 * 60 * 1000,
      })
      .cookie('refresh_token', refreshToken, {
        httpOnly: true,
        secure: true,
        sameSite: 'strict',
        maxAge: 7 * 24 * 60 * 60 * 1000,
      })
      .redirect(`${process.env.FRONTEND_ORIGIN}/dashboard`);
  } catch (e) {
    console.error(e);
    res.status(500).send('Server error');
  } finally {
    client.release();
  }
});

/* ---------- LOGIN ---------- */
router.post(
  '/login',
  loginLimiter,
  [body('email').isEmail().normalizeEmail(), body('password').exists()],
  async (req, res) => {
    const errors = validationResult(req);
    if (!errors.isEmpty()) return res.status(400).json({ errors: errors.array() });

    const { email, password } = req.body;
    const pool = req.app.locals.pool;
    const client = await pool.connect();

    try {
      const userRes = await client.query(
        `SELECT id,password_hash,verified,failed_attempts,lock_until
         FROM users WHERE email=$1`,
        [email]
      );
      if (!userRes.rowCount) {
        await client.query(
          `INSERT INTO login_logs (user_id, ip_address, user_agent, success)
           VALUES (NULL,$1,$2,$3)`,
          [req.ip, req.get('User-Agent'), false]
        );
        return res.status(401).json({ error: 'Invalid credentials' });
      }

      const usr = userRes.rows[0];
      if (usr.lock_until && new Date(usr.lock_until) > new Date())
        return res.status(429).json({ error: 'Account locked – try later.' });

      const match = await bcrypt.compare(password, usr.password_hash);
      if (!match) {
        const attempts = (usr.failed_attempts || 0) + 1;
        const lockUntil = attempts >= 5 ? `NOW() + INTERVAL '30 minutes'` : null;
        await client.query(
          `UPDATE users SET failed_attempts=$1, lock_until=$2 WHERE id=$3`,
          [attempts, lockUntil, usr.id]
        );
        await client.query(
          `INSERT INTO login_logs (user_id, ip_address, user_agent, success)
           VALUES ($1,$2,$3,$4)`,
          [usr.id, req.ip, req.get('User-Agent'), false]
        );
        return res.status(401).json({ error: 'Invalid credentials' });
      }

      // success → reset counters
      await client.query('UPDATE users SET failed_attempts=0, lock_until=NULL WHERE id=$1', [usr.id]);

      const accessToken = jwt.sign(
        { userId: usr.id, verified: usr.verified },
        process.env.JWT_SECRET,
        { expiresIn: process.env.JWT_EXPIRES_IN }
      );
      const refreshToken = jwt.sign({ userId: usr.id }, process.env.REFRESH_TOKEN_SECRET, {
        expiresIn: process.env.REFRESH_EXPIRES_IN,
      });

      // Store refresh token
      await client.query(
        `INSERT INTO refresh_tokens (user_id, token, expires_at)
         VALUES ($1,$2,NOW() + INTERVAL '7 days')
         ON CONFLICT (user_id) DO UPDATE SET token=$2, expires_at=NOW() + INTERVAL '7 days'`,
        [usr.id, refreshToken]
      );

      await client.query(
        `INSERT INTO login_logs (user_id, ip_address, user_agent, success)
         VALUES ($1,$2,$3,$4)`,
        [usr.id, req.ip, req.get('User-Agent'), true]
      );

      res
        .cookie('access_token', accessToken, {
          httpOnly: true,
          secure: true,
          sameSite: 'strict',
          maxAge: 15 * 60 * 1000,
        })
        .cookie('refresh_token', refreshToken, {
          httpOnly: true,
          secure: true,
          sameSite: 'strict',
          maxAge: 7 * 24 * 60 * 60 * 1000,
        })
        .json({ message: 'Login successful' });
    } catch (e) {
      console.error(e);
      res.status(500).json({ error: 'Server error' });
    } finally {
      client.release();
    }
  }
);

/* ---------- REFRESH ---------- */
router.post('/refresh', async (req, res) => {
  const token = req.cookies?.refresh_token;
  if (!token) return res.status(401).json({ error: 'No refresh token' });

  try {
    const payload = jwt.verify(token, process.env.REFRESH_TOKEN_SECRET);
    const pool = req.app.locals.pool;
    const client = await pool.connect();
    const row = await client.query(
      `SELECT token FROM refresh_tokens WHERE user_id=$1 AND token=$2 AND expires_at > NOW()`,
      [payload.userId, token]
    );
    if (!row.rowCount) throw new Error('Invalid');

    const newAccess = jwt.sign(
      { userId: payload.userId },
      process.env.JWT_SECRET,
      { expiresIn: process.env.JWT_EXPIRES_IN }
    );
    res
      .cookie('access_token', newAccess, {
        httpOnly: true,
        secure: true,
        sameSite: 'strict',
        maxAge: 15 * 60 * 1000,
      })
      .json({ message: 'Token refreshed' });
  } catch (e) {
    console.error(e);
    res.status(401).json({ error: 'Invalid refresh token' });
  }
});

/* ---------- LOGOUT ---------- */
router.post('/logout', async (req, res) => {
  const token = req.cookies?.refresh_token;
  if (token) {
    try {
      const payload = jwt.verify(token, process.env.REFRESH_TOKEN_SECRET);
      const pool = req.app.locals.pool;
      await pool.query('DELETE FROM refresh_tokens WHERE user_id=$1', [payload.userId]);
    } catch (_) {}
  }
  res.clearCookie('access_token').clearCookie('refresh_token').json({ message: 'Logged out' });
});

/* ---------- ME (user data) ---------- */
router.get('/me', async (req, res) => {
  const token = req.cookies?.access_token;
  if (!token) return res.status(401).json({ error: 'Unauthenticated' });

  try {
    const payload = jwt.verify(token, process.env.JWT_SECRET);
    const pool = req.app.locals.pool;
    const row = await pool.query(
      `SELECT id,first_name,last_name,email,verified,role FROM users WHERE id=$1`,
      [payload.userId]
    );
    if (!row.rowCount) return res.status(404).json({ error: 'User not found' });
    res.json(row.rows[0]);
  } catch (e) {
    console.error(e);
    res.status(401).json({ error: 'Invalid token' });
  }
});

module.exports = router;
4.3 CV Routes – routes/cv.js
const express = require('express');
const router = express.Router();
const jwt = require('jsonwebtoken');
const Mustache = require('mustache');
const puppeteer = require('puppeteer');
const { body, validationResult } = require('express-validator');
const sanitizeHtml = require('sanitize-html');

/* ---------- JWT MIDDLEWARE ---------- */
function verifyToken(req, res, next) {
  const token = req.cookies?.access_token;
  if (!token) return res.status(401).json({ error: 'Unauthenticated' });
  try {
    req.user = jwt.verify(token, process.env.JWT_SECRET);
    next();
  } catch (e) {
    res.status(401).json({ error: 'Bad token' });
  }
}

/* ---------- VERIFIED‑ONLY MIDDLEWARE ---------- */
function requireVerified(req, res, next) {
  if (!req.user.verified) return res.status(403).json({ error: 'Account not verified' });
  next();
}

/* ---------- TEMPLATE LIST ---------- */
router.get('/templates', async (req, res) => {
  const pool = req.app.locals.pool;
  const { rows } = await pool.query('SELECT id,name,preview_img,description FROM cv_templates WHERE is_active=true');
  res.json(rows);
});

/* ---------- SAVE CV ---------- */
router.post(
  '/save',
  verifyToken,
  [
    body('templateId').isInt(),
    body('data').isObject(),
  ],
  async (req, res) => {
    const errors = validationResult(req);
    if (!errors.isEmpty()) return res.status(400).json({ errors: errors.array() });

    const { templateId, data } = req.body;
    const safeData = JSON.parse(sanitizeHtml(JSON.stringify(data))); // deep sanitize

    const pool = req.app.locals.pool;
    // Upsert – one CV per user (for simplicity)
    await pool.query(
      `INSERT INTO cvs (user_id, template_id, data)
       VALUES ($1,$2,$3::jsonb)
       ON CONFLICT (user_id) DO UPDATE
       SET template_id=$2, data=$3::jsonb, updated_at=NOW()`,
      [req.user.userId, templateId, safeData]
    );
    res.json({ message: 'CV saved' });
  }
);

/* ---------- DOWNLOAD PDF ---------- */
router.get('/download/:cvId', verifyToken, requireVerified, async (req, res) => {
  const cvId = req.params.cvId;
  const pool = req.app.locals.pool;

  const cvRes = await pool.query(
    `SELECT c.data, t.html_template, t.stylesheet
     FROM cvs c
     JOIN cv_templates t ON c.template_id = t.id
     WHERE c.id=$1 AND c.user_id=$2`,
    [cvId, req.user.userId]
  );

  if (!cvRes.rowCount) return res.status(404).json({ error: 'CV not found' });

  const { data, html_template, stylesheet } = cvRes.rows[0];

  // Merge JSON data with Mustache template
  const html = Mustache.render(html_template, {
    ...data,
    color1: req.body?.color1 || '#667eea',
    color2: req.body?.color2 || '#764ba2',
  });

  // Create PDF with Puppeteer (headless Chromium)
  const browser = await puppeteer.launch({ args: ['--no-sandbox'] });
  const page = await browser.newPage();
  await page.setContent(`<style>${stylesheet}</style>${html}`, { waitUntil: 'networkidle0' });
  const pdf = await page.pdf({
    format: 'A4',
    printBackground: true,
    margin: { top: '15mm', bottom: '15mm', left: '12mm', right: '12mm' },
  });
  await browser.close();

  res.set({
    'Content-Type': 'application/pdf',
    'Content-Disposition': `attachment; filename="CV_${cvId}.pdf"`,
    'Content-Length': pdf.length,
  });
  res.send(pdf);
});

module.exports = router;
NOTE:
*All DB queries use parameterised statements → no SQL‑injection.
*User‑provided strings are passed through sanitize-html (or a whitelist of allowed tags) → XSS protection.
*Puppeteer runs in a sandboxed container; the HTML is rendered with a strict CSP set by Helmet.

