3️⃣ Database – schema.sql
-- USERS --------------------------------------------------------------
CREATE TABLE users (
  id               SERIAL PRIMARY KEY,
  first_name       VARCHAR(100) NOT NULL,
  last_name        VARCHAR(100) NOT NULL,
  email            VARCHAR(255) UNIQUE NOT NULL,
  password_hash    VARCHAR(255) NOT NULL,
  verified         BOOLEAN DEFAULT FALSE,
  role             VARCHAR(20) DEFAULT 'user',  -- 'admin' for audit UI
  failed_attempts  INTEGER DEFAULT 0,
  lock_until       TIMESTAMP NULL,
  created_at       TIMESTAMP DEFAULT NOW()
);

-- EMAIL VERIFICATION -------------------------------------------------
CREATE TABLE email_verifications (
  id          SERIAL PRIMARY KEY,
  user_id     INTEGER REFERENCES users(id) ON DELETE CASCADE,
  token       VARCHAR(64) NOT NULL,
  expires_at  TIMESTAMP NOT NULL
);

-- REFRESH TOKENS (single per user) ----------------------------------
CREATE TABLE refresh_tokens (
  user_id   INTEGER PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
  token     TEXT NOT NULL,
  expires_at TIMESTAMP NOT NULL
);

-- TEMPLATE DEFINITIONS -----------------------------------------------
CREATE TABLE cv_templates (
  id          SERIAL PRIMARY KEY,
  name        VARCHAR(100) NOT NULL,
  description TEXT,
  preview_img VARCHAR(255) NOT NULL,          -- small thumbnail url
  stylesheet  TEXT NOT NULL,                  -- raw CSS (or link)
  html_template TEXT NOT NULL,                  -- Mustache/Handlebars template
  is_active   BOOLEAN DEFAULT TRUE
);

-- USER CV STORAGE ----------------------------------------------------
CREATE TABLE cvs (
  id          SERIAL PRIMARY KEY,
  user_id     INTEGER REFERENCES users(id) ON DELETE CASCADE,
  template_id INTEGER REFERENCES cv_templates(id),
  data        JSONB NOT NULL,                 -- raw field data (no HTML)
  created_at  TIMESTAMP DEFAULT NOW(),
  updated_at  TIMESTAMP DEFAULT NOW()
);

-- LOGIN / SIGN‑UP AUDIT LOGS -----------------------------------------
CREATE TABLE login_logs (
  id          SERIAL PRIMARY KEY,
  user_id     INTEGER REFERENCES users(id) ON DELETE SET NULL,
  ip_address  VARCHAR(45),
  user_agent  TEXT,
  success     BOOLEAN,
  created_at  TIMESTAMP DEFAULT NOW()
);

CREATE TABLE signup_logs (
  id          SERIAL PRIMARY KEY,
  user_id     INTEGER REFERENCES users(id) ON DELETE SET NULL,
  ip_address  VARCHAR(45),
  user_agent  TEXT,
  success     BOOLEAN,
  created_at  TIMESTAMP DEFAULT NOW()
);
Run this file when you spin up the DB (docker-compose up db → psql -U app_user -d cv_builder -f schema.sql).

