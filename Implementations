export default function CvBuilder({ template, data, setData }) {
  /** Helper that updates nested arrays safely */
  const updateArray = (arrName, idx, key, value) => {
    const copy = [...data[arrName]];
    copy[idx][key] = value;
    setData({ ...data, [arrName]: copy });
  };

  const addEntry = (arrName, emptyObj) => {
    const copy = [...(data[arrName] || []), emptyObj];
    setData({ ...data, [arrName]: copy });
  };

  const removeEntry = (arrName, idx) => {
    const copy = data[arrName].filter((_, i) => i !== idx);
    setData({ ...data, [arrName]: copy });
