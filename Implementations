/* ------------------------ helpers ------------------------ */
const addToArray = (arrName: string, emptyObj: any, data: any, setData: any) => {
  const newArr = [...(data[arrName] || []), emptyObj];
  setData({ ...data, [arrName]: newArr });
};

const updateArrayField = (arrName: string, idx: number, key: string, value: any, data: any, setData: any) => {
  const newArr = [...data[arrName]];
  newArr[idx][key] = value;
  setData({ ...data, [arrName]: newArr });
};

const removeFromArray = (arrName: string, idx: number, data: any, setData: any) => {
  const newArr = data[arrName].filter((_ : any, i: number) => i !== idx);
  setData({ ...data, [arrName]: newArr });
};

